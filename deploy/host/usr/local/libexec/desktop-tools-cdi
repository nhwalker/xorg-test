#!/bin/bash
# Write the CDI spec that gives client containers the desktop's client tools
# (run by desktop-tools-cdi.service, triggered by desktop-tools-cdi.path).
#
#   desktop.local/tools=all   $TOOLS_DIR mounted read-only + $TOOLS_ENV
#
# ONE device for the whole toolkit, not one per tool, because a binary is not a
# capability - a socket is. Injecting `screenshot` into a container grants it
# nothing on its own; what grants access is whether the container also holds
# desktop.local/display and can therefore reach the X socket. Capability stays
# enforced by the display/audio split; this device only distributes files.
#
# WHY THIS IS A SEPARATE SCRIPT FROM desktop-client-cdi
#
# That one writes its specs unconditionally at boot, because a display or audio
# spec is a pure function of exported paths - see its header. This one is
# written only once $TOOLS_DIR is NOT EMPTY, and that difference is deliberate:
#
#   - Sockets are LIVE state. They appear and vanish with the desktop's process
#     lifecycle, so gating a spec on them would flap on every restart, and a
#     client that starts early simply finds nothing to connect to.
#   - This directory is PROVISIONING state. It is empty only between host
#     provisioning and the desktop's first start, and populated from then on.
#
# So the resource means "this node has been provisioned with the toolkit", NOT
# "the toolkit is current" - a .path unit fires when its condition becomes true
# and nothing removes this spec if the directory is later emptied. That is the
# honest guarantee; do not build anything on a stronger reading.
#
# What it buys: on a node where the desktop has never come up, a client
# requesting desktop.local/tools fails to SCHEDULE ("Insufficient
# desktop.local/tools") instead of starting and dying on "command not found"
# somewhere inside the application. It also means the mount below can never
# reference a missing hostPath, which would fail container creation outright.
#
# Defaults match the quadlet/chart exports. Override per host by dropping
# assignments into /etc/desktop-container/client-cdi.conf, e.g.
#   TOOLS_DIR=/opt/desktop-container/bin
set -euo pipefail

CDI_DIR=/etc/cdi
TOOLS_SPEC="$CDI_DIR/desktop-tools.yaml"
CONF=/etc/desktop-container/client-cdi.conf

# Vendor/class of the CDI device. This name is the client contract; changing
# it is an API break across the cluster.
TOOLS_KIND="desktop.local/tools"
CDI_DEVICE="all"
# Host directory the desktop publishes into (see publish-tools.sh in the image).
TOOLS_DIR="/var/lib/desktop-container/bin"
# Where it lands inside the client, and the env var pointing at it.
#
# NOT the same path in and out, unlike the socket dirs: those must match because
# DISPLAY and PULSE_SERVER embed absolute paths. Nothing forces that here, and
# /var/lib/desktop-container inside an unrelated client would imply this
# software is installed there. /opt is what the FHS reserves for add-on
# packages, which is exactly what an injected toolkit is.
#
# Not mounted over /usr/local/bin (which would put it on PATH): that would
# silently shadow whatever the client image installed there. PATH is not
# injected either - CDI env edits are absolute assignments, so setting PATH
# would clobber the image's own.
TOOLS_MOUNT="/opt/desktop-tools/bin"
TOOLS_ENV="DESKTOP_TOOLS_BIN"

# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"

# The gate. Not an error: on a freshly provisioned host this script runs before
# the desktop has ever published, and writing a spec for an empty toolkit is
# precisely what this design exists to avoid.
#
# Regular files only, and never dotfiles: publish-tools.sh stages each tool as
# a ".name.XXXXXX" temp file before renaming it into place, so a publish that
# died part-way leaves one behind. Counting that as "populated" would advertise
# a toolkit containing no tools - the exact failure this gate exists to prevent.
if ! find "$TOOLS_DIR" -mindepth 1 -maxdepth 1 -type f ! -name '.*' \
        -print -quit 2>/dev/null | read -r _; then
    echo "$TOOLS_DIR is empty or missing: not advertising $TOOLS_KIND yet"
    exit 0
fi

mkdir -p "$CDI_DIR"

# Same atomic write as desktop-client-cdi: CDI consumers rescan the spec dirs
# on change, and a half-written spec parses as invalid and fails container
# creation for as long as the write takes.
write_spec() { # $1: destination; spec body on stdin
    local dest="$1" tmp
    tmp=$(mktemp "$dest.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$dest"
    trap - EXIT
}

write_spec "$TOOLS_SPEC" <<EOF
# Generated by desktop-tools-cdi - do not edit; edit $CONF instead.
# Grants a container the desktop's client tools. This is NOT a capability:
# the binaries do nothing without the socket they talk to, which comes from
# $TOOLS_KIND's siblings (desktop.local/display, desktop.local/audio).
#   podman run --device $TOOLS_KIND=$CDI_DEVICE ...
#   k8s: via a device plugin advertising $TOOLS_KIND=$CDI_DEVICE
cdiVersion: 0.5.0
kind: $TOOLS_KIND
devices:
  - name: $CDI_DEVICE
    containerEdits:
      env:
        - $TOOLS_ENV=$TOOLS_MOUNT
      mounts:
        # ro: clients run these, they never write them. rw would let any client
        # replace a binary that every other client executes.
        #
        # The DIRECTORY, not the individual tools: the desktop republishes each
        # one by rename (a new inode, so a client mid-exec is never broken), and
        # a per-file bind mount would pin the client to the inode that was
        # current when it started.
        - hostPath: $TOOLS_DIR
          containerPath: $TOOLS_MOUNT
          options: ["rbind", "ro"]
EOF

echo "wrote $TOOLS_SPEC ($TOOLS_KIND=$CDI_DEVICE -> $TOOLS_MOUNT, $TOOLS_ENV)"
