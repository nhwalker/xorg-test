#!/bin/bash
# Write /etc/cdi/desktop.yaml: the CDI spec that gives a client container
# the desktop's X display and audio (run by desktop-display-cdi.service;
# see deploy/README.md).
#
# This is the whole client-side mechanism. A container that resolves the
# CDI device desktop.local/display=all gets the two exported socket dirs
# bind-mounted and DISPLAY / PULSE_SERVER / PIPEWIRE_REMOTE set, from the
# runtime itself - podman via --device, CRI-O via the pod annotation
#   cdi.k8s.io/display: desktop.local/display=all
# so no volumes, no env, and no kubelet plugin are involved.
#
# The spec describes the EXPORT CONTRACT, not the desktop's current state:
# it is a pure function of the paths and DISPLAY the desktop publishes, so
# there is nothing to converge and no health to track. Writing it when the
# desktop is down is correct - a client that starts early simply finds no
# socket to connect to, exactly as it would with any other bind mount.
#
# Defaults match the quadlet/chart exports. Override per host by dropping
# assignments into /etc/desktop-container/display-cdi.conf, e.g.
#   DISPLAY_VALUE=:1
set -euo pipefail

SPEC=/etc/cdi/desktop.yaml
CONF=/etc/desktop-container/display-cdi.conf

# Vendor/class of the CDI device clients ask for. Must match the pod
# annotation / --device reference; changing it is an API break for every
# client manifest on the cluster.
CDI_KIND="desktop.local/display"
CDI_DEVICE="all"
DISPLAY_VALUE=":0"
X11_DIR="/tmp/.X11-unix"
AUDIO_DIR="/run/desktop-audio"

# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"

case "$DISPLAY_VALUE" in
    :[0-9]*) ;;
    *) echo "DISPLAY_VALUE must look like ':N', got '$DISPLAY_VALUE'" >&2; exit 1 ;;
esac

mkdir -p /etc/cdi
# Write via a temp file in the same dir + rename: CDI consumers rescan
# /etc/cdi on change, and a half-written spec would be parsed as invalid
# and fail container creation for as long as the write takes.
tmp=$(mktemp "$SPEC.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<EOF
# Generated by desktop-display-cdi - do not edit; edit $CONF instead.
# Grants a container the containerized desktop's X display and audio.
#   podman run --device $CDI_KIND=$CDI_DEVICE ...
#   k8s pod annotation: cdi.k8s.io/display: "$CDI_KIND=$CDI_DEVICE"
cdiVersion: 0.5.0
kind: $CDI_KIND
devices:
  - name: $CDI_DEVICE
    containerEdits:
      env:
        - DISPLAY=$DISPLAY_VALUE
        - PULSE_SERVER=unix:$AUDIO_DIR/pulse
        - PIPEWIRE_REMOTE=$AUDIO_DIR/pipewire-0
      mounts:
        # rw, not ro: connect(2) on a unix socket needs write access to
        # the socket inode, so a read-only mount would let the client see
        # the display and then refuse to open it.
        - hostPath: $X11_DIR
          containerPath: $X11_DIR
          options: ["rbind", "rw"]
        - hostPath: $AUDIO_DIR
          containerPath: $AUDIO_DIR
          options: ["rbind", "rw"]
EOF
chmod 644 "$tmp"
mv "$tmp" "$SPEC"
trap - EXIT
echo "wrote $SPEC ($CDI_KIND=$CDI_DEVICE -> DISPLAY=$DISPLAY_VALUE, $X11_DIR, $AUDIO_DIR)"
