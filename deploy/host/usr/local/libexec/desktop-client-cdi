#!/bin/bash
# Write the CDI specs that let OTHER containers use this desktop (run by
# desktop-client-cdi.service; see deploy/README.md).
#
# Two devices, one capability each, so a client asks for what it needs and
# nothing more:
#
#   desktop.local/display=all   DISPLAY + the X socket dir
#   desktop.local/audio=all     PULSE_SERVER/PIPEWIRE_REMOTE + the audio dir
#
# The split is about privilege, not tidiness. X11 here runs with
# `xhost +local:`, so any client on the display can read every keystroke,
# screenshot other windows and inject events; and the audio socket allows
# RECORDING, not just playback. Neither half is harmless, and few clients
# need both, so granting them separately is the point.
#
# These specs ARE the client contract. A container that resolves a device
# gets its edits applied by the runtime itself, so no client declares
# volumes or env of its own:
#   podman:     --device desktop.local/display=all [--device desktop.local/audio=all]
#   kubernetes: request the resource that charts/cdi-device-plugin
#               advertises for that device (a pod annotation does NOT
#               work - kubelet never passes those to CDI injection).
#
# A spec describes the EXPORT CONTRACT, not the desktop's current state:
# it is a pure function of the paths and DISPLAY the desktop publishes, so
# there is nothing to converge and no health to track. Writing them when
# the desktop is down is correct - a client that starts early simply finds
# no socket to connect to, exactly as with any other bind mount.
#
# Defaults match the quadlet/chart exports. Override per host by dropping
# assignments into /etc/desktop-container/client-cdi.conf, e.g.
#   DISPLAY_VALUE=:1
set -euo pipefail

CDI_DIR=/etc/cdi
DISPLAY_SPEC="$CDI_DIR/desktop-display.yaml"
AUDIO_SPEC="$CDI_DIR/desktop-audio.yaml"
# Predecessor of the two specs above, when one device carried both
# capabilities. Removed rather than left behind: a stale copy keeps
# resolving, which would silently re-grant audio to display-only clients.
LEGACY_SPEC="$CDI_DIR/desktop.yaml"
CONF=/etc/desktop-container/client-cdi.conf

# Vendor/class of each CDI device. These are the names every client
# manifest references; changing one is an API break across the cluster.
DISPLAY_KIND="desktop.local/display"
AUDIO_KIND="desktop.local/audio"
CDI_DEVICE="all"
DISPLAY_VALUE=":0"
X11_DIR="/tmp/.X11-unix"
AUDIO_DIR="/run/desktop-audio"

# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"

case "$DISPLAY_VALUE" in
    :[0-9]*) ;;
    *) echo "DISPLAY_VALUE must look like ':N', got '$DISPLAY_VALUE'" >&2; exit 1 ;;
esac

mkdir -p "$CDI_DIR"

# Write via a temp file in the same dir + rename: CDI consumers rescan the
# spec dirs on change, and a half-written spec would be parsed as invalid
# and fail container creation for as long as the write takes.
# Validation runs before any write, so a rejected config leaves BOTH
# existing specs untouched. Each file is replaced atomically; the pair is
# not transactional, but nothing between the two calls can fail on config.
write_spec() { # $1: destination; spec body on stdin
    local dest="$1" tmp
    tmp=$(mktemp "$dest.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$dest"
    trap - EXIT
}

write_spec "$DISPLAY_SPEC" <<EOF
# Generated by desktop-client-cdi - do not edit; edit $CONF instead.
# Grants a container the containerized desktop's X display (NOT audio,
# which is $AUDIO_KIND=$CDI_DEVICE).
#   podman run --device $DISPLAY_KIND=$CDI_DEVICE ...
#   k8s: via a device plugin advertising $DISPLAY_KIND=$CDI_DEVICE
cdiVersion: 0.5.0
kind: $DISPLAY_KIND
devices:
  - name: $CDI_DEVICE
    containerEdits:
      env:
        - DISPLAY=$DISPLAY_VALUE
      mounts:
        # rw, not ro: connect(2) on a unix socket needs write access to
        # the socket inode, so a read-only mount would let the client see
        # the display and then refuse to open it.
        #
        # The DIRECTORY, not the socket file: Xorg unlinks and recreates
        # its socket on restart, and a file bind mount would pin the dead
        # inode.
        - hostPath: $X11_DIR
          containerPath: $X11_DIR
          options: ["rbind", "rw"]
EOF

write_spec "$AUDIO_SPEC" <<EOF
# Generated by desktop-client-cdi - do not edit; edit $CONF instead.
# Grants a container the containerized desktop's audio (NOT the display,
# which is $DISPLAY_KIND=$CDI_DEVICE). This includes RECORDING: a client
# with this device can capture from sources, microphone included.
#   podman run --device $AUDIO_KIND=$CDI_DEVICE ...
#   k8s: via a device plugin advertising $AUDIO_KIND=$CDI_DEVICE
cdiVersion: 0.5.0
kind: $AUDIO_KIND
devices:
  - name: $CDI_DEVICE
    containerEdits:
      env:
        - PULSE_SERVER=unix:$AUDIO_DIR/pulse
        - PIPEWIRE_REMOTE=$AUDIO_DIR/pipewire-0
      mounts:
        # Both protocols live in this one directory, and ALSA clients
        # reach it through the pulse socket, so there is nothing finer to
        # split here - see deploy/README.md. Directory, not socket files:
        # PipeWire recreates them on restart.
        - hostPath: $AUDIO_DIR
          containerPath: $AUDIO_DIR
          options: ["rbind", "rw"]
EOF

if [ -e "$LEGACY_SPEC" ]; then
    rm -f "$LEGACY_SPEC"
    echo "removed superseded $LEGACY_SPEC (its device granted display+audio together)"
fi

echo "wrote $DISPLAY_SPEC ($DISPLAY_KIND=$CDI_DEVICE -> DISPLAY=$DISPLAY_VALUE, $X11_DIR)"
echo "wrote $AUDIO_SPEC ($AUDIO_KIND=$CDI_DEVICE -> $AUDIO_DIR)"
