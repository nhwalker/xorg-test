#!/bin/bash
# Export the identity of a host account for the container's desktop user to
# adopt (run at every boot by desktop-user-sync.service; see deploy/README.md
# "Desktop user identity").
#
# The account is named in /etc/desktop-container/desktop-user (shipped empty
# by this tree = feature off). Its uid/gid/gecos/shell and its /etc/shadow
# password field are written alongside, into the same directory the quadlet
# already bind-mounts read-only into the container. The container-side half is
# image/session/align-desktop-user.sh.
#
# Re-running this mid-uptime refreshes the export (e.g. after the host user
# changed their password); the running container keeps the old values until
# desktop.service restarts.
set -euo pipefail

DIR=/etc/desktop-container
SEL="$DIR/desktop-user"
ENVF="$DIR/desktop-user.env"
HASHF="$DIR/desktop-user.hash"

clear_export() { rm -f "$ENVF" "$HASHF"; }

# Comments and blank lines allowed (unlike shell-user, which is machine-set):
# this file is edited by hand and ships with its instructions inline.
user=$(sed 's/#.*//' "$SEL" 2>/dev/null | tr -d '[:blank:]' | grep -v '^$' | head -n1 || true)
if [ -z "$user" ]; then
    clear_export
    echo "no account named in $SEL; the container keeps its built-in uid 1000"
    exit 0
fi

# A named-but-missing account is a misconfiguration, not a default: fail
# visibly. desktop.service only Wants= this unit, so the desktop still boots
# (with its built-in identity) while `systemctl status` shows why.
if ! ent=$(getent passwd "$user"); then
    clear_export
    echo "account '$user' named in $SEL does not exist on this host" >&2
    exit 1
fi

uid=$(echo "$ent" | cut -d: -f3)
gid=$(echo "$ent" | cut -d: -f4)
gecos=$(echo "$ent" | cut -d: -f5)
home=$(echo "$ent" | cut -d: -f6)
shell=$(echo "$ent" | cut -d: -f7)
group=$(getent group "$gid" | cut -d: -f1 || true)

if [ "$uid" = 0 ] || [ "$gid" = 0 ]; then
    clear_export
    echo "refusing to export '$user': the desktop session user must not be root (uid $uid, gid $gid)" >&2
    exit 1
fi

umask 022
tmp=$(mktemp "$ENVF.XXXXXX")
cat > "$tmp" <<EOF
# Generated by desktop-user-sync at boot -- edits are overwritten.
# Source: getent passwd $user
DESKTOP_HOST_USER=$user
DESKTOP_UID=$uid
DESKTOP_GID=$gid
DESKTOP_GROUP=$group
DESKTOP_GECOS=$gecos
DESKTOP_SHELL=$shell
DESKTOP_HOST_HOME=$home
EOF
chmod 0644 "$tmp"
mv -f "$tmp" "$ENVF"

# Password field, verbatim. getent shadow needs root and is empty on hosts
# whose NSS has no shadow provider for local users; read the file directly
# then. An account with no hash simply gets no hash file.
hash=$(getent shadow "$user" 2>/dev/null | cut -d: -f2 || true)
if [ -z "$hash" ]; then
    hash=$(awk -F: -v u="$user" '$1 == u { print $2 }' /etc/shadow 2>/dev/null || true)
fi
if [ -z "$hash" ]; then
    rm -f "$HASHF"
    echo "no shadow entry for '$user'; exporting identity only, no password"
else
    tmp=$(mktemp "$HASHF.XXXXXX")
    printf '%s\n' "$hash" > "$tmp"
    # Root-only on the host. The container reads it as its own root, which is
    # the host's root under --privileged; see deploy/README.md "Security notes".
    chmod 0400 "$tmp"
    mv -f "$tmp" "$HASHF"
fi

# SELinux: freshly created files can carry the wrong context for the bind
# mount. No-op on non-SELinux hosts.
if command -v restorecon >/dev/null; then
    restorecon -R "$DIR" || true
fi

echo "desktop user converged: container 'desktop' will mirror host '$user' (uid $uid, gid $gid${group:+ $group})"
