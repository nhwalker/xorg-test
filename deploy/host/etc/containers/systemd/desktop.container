# Containerized desktop, declarative deployment (see deploy/README.md).
# Lives at /etc/containers/systemd/desktop.container; systemd's quadlet
# generator turns it into "desktop.service" at daemon-reload (podman >= 4.4;
# the drop-in overlays are silently IGNORED before podman 5.0 - see
# deploy/README.md "Requirements"). The [Install] section is honored by the
# generator itself, so there is no "systemctl enable" step for quadlet
# units - the service comes up on every boot of multi-user.target.
#
# Nothing in the deploy tree builds or pulls images: provisioning must have
# put the image in podman's storage already (podman load / podman pull).
# Override the reference per host class with a drop-in:
#   /etc/containers/systemd/desktop.container.d/50-image.conf
#     [Container]
#     Image=registry.example.com/desktop-container@sha256:...

[Unit]
Description=Containerized desktop (Xorg + mwm + PipeWire)
# Runtime backstop for the seat handover: nothing else may hold the VT or
# DRM master while the desktop runs. On a correctly provisioned host these
# are no-ops - the getty@tty1 mask and the multi-user default target in this
# tree keep both units from ever starting.
Conflicts=getty@tty1.service display-manager.service
After=getty@tty1.service display-manager.service
# Seat convergence: walk back whatever seat state the host is in (display
# manager, gettys, loginctl seat splits, graphical default target) and
# verify DRM/the VT are takeable before the desktop starts - see
# usr/local/libexec/seat-prep.sh in this tree.
Wants=desktop-seat-prep.service
After=desktop-seat-prep.service
# CDI spec convergence: real spec on GPU hosts, no-op stub elsewhere, so
# the unconditional AddDevice= below always resolves (see that unit and
# usr/local/libexec/desktop-cdi-refresh in this tree).
Wants=desktop-cdi-refresh.service
After=desktop-cdi-refresh.service
# Client-side CDI specs (desktop.local/display and desktop.local/audio):
# what OTHER containers resolve to get this desktop's X socket or audio,
# one capability each. Independent of the desktop itself - they ship
# enabled for multi-user.target too, because kubelet must find the specs
# before it admits a client pod that requests one, which can happen on a
# boot where this unit has not started yet.
Wants=desktop-client-cdi.service
After=desktop-client-cdi.service
# SELinux labels for the same three directories the specs above and the
# toolkit spec below mount into clients. Without container_file_t on them, a
# CONFINED client on an enforcing host resolves its device, gets the mounts
# and env, and is then denied on connect(2)/exec - see
# usr/local/libexec/desktop-selinux in this tree. Shipped pre-enabled for
# multi-user.target alongside desktop-client-cdi, for the same reason: specs
# and labels are two halves of one export contract.
Wants=desktop-selinux.service
After=desktop-selinux.service
# Client toolkit CDI spec (desktop.local/tools). A .path unit rather than a
# oneshot, because the spec may only be written once the desktop has published
# its tools - see usr/local/libexec/desktop-tools-cdi in this tree.
#
# Pulled in here for the same reason the units above are, and for one more:
# the tree ships this .path pre-enabled, but a multi-user.target.wants symlink
# only takes effect at BOOT. Applying the tree to a running host and doing
# `systemctl daemon-reload` enables the watcher without ever starting it, so
# the desktop would publish its toolkit into a directory nothing was watching
# and the device would never be advertised until the next reboot.
Wants=desktop-tools-cdi.path
After=desktop-tools-cdi.path
# Host login session: a real PAM/logind session for the desktop user on
# seat0/tty1, opened host-side because the container has no logind of its
# own (see that unit's header). Wants+PartOf make the pair move together:
# this Wants= pulls the session up with every container start, and the
# session's PartOf=desktop.service stops and restarts it with the
# container. Wants and not Requires, deliberately: the desktop must still
# run on a host that disables the session unit - desktop-init falls back to
# fabricating the runtime dir itself.
Wants=desktop-session.service
# Host Terminal, always on: a fresh loopback-ssh keypair is generated every
# boot for the dedicated 'desktop-shell' account (see deploy/README.md
# "Host Terminal"). To ship hosts WITHOUT it, comment out the next two
# lines: with no key generated, nothing can log into the account and the
# container's menu entry degrades gracefully.
Wants=desktop-host-shell.service
After=desktop-host-shell.service

[Container]
Image=localhost/desktop-container:latest
ContainerName=desktop
# Host network namespace: kernel uevents are delivered over netlink, which is
# per-netns, so libinput in the container sees them. The uevent alone is not
# enough - the device NODE has to be there too, which is what the /dev/input
# bind mount below provides.
Network=host
# Live view of the host's input devices. Podman gives the container its own
# /dev (a tmpfs populated at creation, which is also why ensure-vt-devices.sh
# has to mknod the VT nodes), so without this a device node the host gains
# later never appears inside: libinput gets the uevent, tries to open the path
# and finds nothing.
#
# That matters beyond plugging in a new keyboard. A USB KVM switch without HID
# emulation electrically disconnects the keyboard and mouse on every switch and
# re-enumerates them on the way back, often at a different eventN - so without
# a live view, input dies on the first switch back and stays dead until
# desktop.service restarts.
#
# Just /dev/input, not all of /dev: podman's own /dev/console, /dev/pts and
# /dev/shm are what --tty (and the console logging it carries) depend on, and
# a blanket /dev:/dev would shadow them. Read-write because libinput needs to write to
# evdev nodes (EVIOCGRAB, LEDs).
#
# The device cgroup still governs access to what this exposes, and a bind
# mount is not a device as far as that cgroup is concerned - so major 13 has
# to be allowed explicitly below, or this mount resolves to nodes the
# container may not open.
Volume=/dev/input:/dev/input
# Host udev database (read-only): lets libinput/logind enumerate devices and
# see the host's seat tags without running udevd in the container.
Volume=/run/udev:/run/udev:ro
# Exported X socket: host / other containers connect with DISPLAY=:0.
Volume=/tmp/.X11-unix:/tmp/.X11-unix
# Exported audio sockets (PipeWire native + Pulse), see README.
Volume=/run/desktop-audio:/run/desktop-audio
# Client toolkit: the desktop publishes its client tools here at boot, and the
# desktop.local/tools CDI device mounts them (read-only) into client
# containers. Writing into it is what makes the host advertise that device -
# see desktop-tools-cdi.path.
Volume=/var/lib/desktop-container/bin:/var/lib/desktop-container/bin
# Host-shell material for the 'Host Terminal' menu entry: the static
# shell-user file from this tree plus the boot-fresh keypair written by
# desktop-host-shell.service (harmless when absent/empty).
Volume=/etc/desktop-container:/etc/desktop-container:ro
# The host's per-user runtime dirs, rslave so mounts PROPAGATE: logind
# mounts a tmpfs at /run/user/61000 only when desktop-session.service opens
# the session, which is after this container was created - a private bind
# taken at create time would never see it. Through this, the container's
# session uses the SAME runtime dir logind manages on the host (the
# XDG_RUNTIME_DIR contract, met by the component that owns it), and
# desktop-init stops fabricating one when the host session is present.
# The parent dir rather than /run/user/61000 itself, because the subdir
# does not exist yet at container-create time. Visibility note: this brings
# every host user's runtime dir into the (trusted, unconfined) container's
# mount view; permissions still apply, but it is one more reason DAC_OVERRIDE
# below is on the trim list.
Volume=/run/user:/run/user:rslave
# systemd mode used to put tmpfs on /run and /tmp; without it (--systemd=false
# below) state them explicitly. /run must not persist across restarts (stale
# pids, sockets, the desktop-init-ready marker), and /tmp holds Xorg's own
# .X0-lock. The /run/udev and /run/desktop-audio volumes above mount over
# this tmpfs, unaffected.
Tmpfs=/run
Tmpfs=/tmp
# /sys, read-only and NON-recursive, stated explicitly. Rootful podman with
# no user namespace takes its fresh-sysfs path and mounts /sys WRITABLE by
# default; the old systemd-mode container ended up read-only anyway, so the
# writable mount only surfaced once systemd left the image (the e2e's
# verify-privileges caught it) - and a writable /sys is the sixth grant
# --privileged bundles. A user mount at /sys supersedes podman's default
# (SupersedeUserMounts in podman's specgen). Via the first-class Mount= key,
# NOT PodmanArgs: an extra PodmanArgs= line carrying this --mount was
# silently dropped by quadlet on the e2e host.
# Non-recursive on purpose: everything the session reads (/sys/class,
# /sys/devices) is sysfs proper, and the host's sysfs SUBMOUNTS (cgroupfs,
# selinuxfs, debugfs) are not carried into the container at all, which beats
# remounting each of them read-only. podman's default masks over
# /sys/firmware etc. still apply on top. The container preflight reports the
# mount state at every boot; verify-privileges asserts it.
Mount=type=bind,source=/sys,destination=/sys,ro=true,bind-nonrecursive=true
# GPU, always on: most deployments have an NVIDIA GPU, and the rest resolve
# this against the stub CDI spec desktop-cdi-refresh writes (which injects
# only the NVIDIA_CDI_STUB=1 marker), so the same unit serves both. The env
# var is inert without the NVIDIA stack.
# Older nvidia container toolkits omit the Xorg driver module from the CDI
# spec (preflight then warns 'nvidia_drv.so NOT injected'): pin a toolkit
# that includes it, or bind-mount the host's copies:
#   Volume=/usr/lib64/xorg/modules/drivers/nvidia_drv.so:/usr/lib64/xorg/modules/drivers/nvidia_drv.so:ro
#   Volume=/usr/lib64/xorg/modules/extensions/libglxserver_nvidia.so:/usr/lib64/xorg/modules/extensions/libglxserver_nvidia.so:ro
AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_DRIVER_CAPABILITIES=all
# --- logging ------------------------------------------------------------------
# desktop-init and everything it starts write straight to /dev/console (the
# pty --tty allocates), which is what `podman logs desktop` reads. No journal,
# no forwarder: with no systemd in the image there is no journald, so the
# console IS the log. It is still a CONTINUOUS stream from a machine meant to
# run for months, so the sink it lands in has to be bounded or it is a slow
# disk-filling bug.
#
# Nothing bounded it before: with no driver named here the bound came from
# whatever /usr/share/containers/containers.conf the host happens to ship.
# podman's own built-in default is k8s-file with log_size_max unlimited - an
# ever-growing file under /var/lib/containers - and a distro that defaults to
# journald instead sends the container's entire journal into the HOST journal,
# where it is bounded but evicts everything else. Neither is a property this
# unit should inherit by accident.
#
# So both halves are stated explicitly:
#   LogDriver=k8s-file   a per-container file, so the desktop's chatter cannot
#                        push the host's own logs out of the host journal.
#                        `podman logs` reads it either way. (The in-container
#                        half of the old logging bound - journald's
#                        RuntimeMaxUse - is gone WITH journald; this file is
#                        now the only sink and the only bound needed.)
#   --log-opt max-size   the actual bound. In PodmanArgs rather than as a
#                        LogOpt= key because that key needs podman 5.0, and
#                        this tree still targets older quadlet (see the drop-in
#                        note in ci.yml). LogDriver= has existed far longer, so
#                        it stays a proper key.
# Raise max-size if a deployment wants more history; the point is that a number
# is stated at all. verify-log-bounds in the e2e asserts BOTH reached the
# running container, because a log option that silently did not apply looks
# exactly like one that did until the disk fills.
LogDriver=k8s-file

# --- privileges --------------------------------------------------------------
# NOT --privileged. That single flag bundles six separate grants - every
# capability, no seccomp filter, no SELinux separation, an open device cgroup,
# the host's device nodes, and a writable /sys - and this needs only some of
# them. What follows grants those and nothing else.
#
# The display server is why this is possible at all: Xorg runs ROOTLESS as the
# 'desktop' user and opens /dev/dri and /dev/input by plain group permission
# (see image/xorg/Xwrapper.config and align-device-groups.sh). Most
# containerised X needs broad capability because X runs as root; this does not.
# With systemd gone from the image (see --pid=host below and desktop-init's
# header), what remains is what the init script, the suid Xorg wrapper and the
# VT need - notably NOT CAP_SYS_ADMIN, which the systemd design could never
# drop and which was the single capability keeping this container "trusted".

# Devices. Explicit nodes rather than the host's whole /dev.
#   dri  the GPU: KMS and render nodes, opened by group by rootless Xorg
# Input and SOUND are not here: both need a LIVE view, which their bind
# mounts (above, and just below) provide. A --device snapshot would defeat
# it. /dev/dri is the one that can stay a device grant, because a GPU is not
# a thing that appears on a running desk.
# The leading '-' makes it OPTIONAL: podman refuses to create the container
# at all if an AddDevice= path is missing ("stat /dev/dri: no such file or
# directory"), and a host without KMS is a host the desktop should still
# start on so that preflight can say what is wrong. That is the same
# reasoning as the stub NVIDIA CDI spec: always resolve, and let the
# in-container preflight report the real problem rather than failing at
# container creation with a message about stat.
AddDevice=-/dev/dri
# Live view of the host's sound cards, for exactly the reason /dev/input is
# one. This was AddDevice=-/dev/snd, and that is a CREATION-TIME SNAPSHOT:
# podman gives the container its own /dev tmpfs and populates it once, so a
# USB headset, DAC or dock plugged in afterwards never appeared inside -
# no new controlC*, no device in WirePlumber - until desktop.service
# restarted. On a KVM'd desk that is the same scenario as the keyboard,
# with the same answer.
#
# The uevent half is already covered: Network=host above is what lets the
# container receive kernel uevents at all (netlink is per-netns), and
# /run/udev gives libudev the host's database. This mount supplies the
# matching device nodes, which is the half that was missing.
#
# Read-write: ALSA device nodes are opened for playback and capture, and
# PipeWire sets mixer controls.
#
# On a host with no sound hardware /dev/snd does not exist, and podman
# REFUSES to create a container whose bind source is missing ("statfs
# /dev/snd: no such file or directory"). It does not create the source, and
# Volume= has no optional marker the way AddDevice= has its '-' prefix - so
# the graceful degradation that prefix used to buy is preserved by the
# tmpfiles.d entry in this tree, which creates an empty /dev/snd at boot.
# The container then starts and its preflight reports "no /dev/snd/controlC*
# visible", exactly as before. ci/smoke-deploy.sh runs on a runner with no
# sound card, so that path is exercised on every PR.
Volume=/dev/snd:/dev/snd
# The device cgroup still gates every one of those, and bind mounts are not
# devices as far as it is concerned - so /dev/input and /dev/snd need their
# majors allowed explicitly or those mounts resolve to nodes the container
# may not open.
#   13  input   (evdev; the bind mount)
#   116 snd     (ALSA; the bind mount)
#   4   VTs     (tty0/tty1, created by ensure-vt-devices.sh)
#   5   console (/dev/console, /dev/tty, ptmx)
#   226 dri     (also granted by AddDevice= when the node exists)
# 116 used to be listed as merely redundant with AddDevice=-/dev/snd; it is
# now the ONLY thing granting sound, since that line became a bind mount.
# 226 is still stated here as well as implied, because AddDevice=-/dev/dri is
# optional ('-' prefix) and so may grant nothing: this keeps the cgroup policy
# a property of the unit rather than of what the host happens to have. It also
# has to cover majors the host gains LATER - a hot-added USB card's nodes are
# permitted by this rule, not by anything evaluated at creation.

# Realtime scheduling for the audio stack, WITHOUT rtkit. PipeWire runs as the
# unprivileged 'desktop' user, so it cannot use the container's CAP_SYS_NICE -
# capabilities are per-process and a user session does not inherit it. rtkit
# existed to bridge that gap, and it cannot run here (see the mask in
# Containerfile: it wants SYS_PTRACE, DAC_READ_SEARCH and NET_ADMIN, which are
# exactly the capabilities worth withholding). RLIMIT_RTPRIO is the other route
# to SCHED_FIFO for an unprivileged process and needs no capability at all, so
# PipeWire gets its RT threads and the dangerous capabilities stay dropped.
# memlock likewise replaces the CAP_IPC_LOCK that PipeWire would otherwise want
# for its buffers. With no systemd in the image the limits reach PipeWire by
# plain inheritance (desktop-init -> start-session -> the daemons).
#
# --- every flag on the PodmanArgs line, and why ------------------------------
# These are the options quadlet has no key of its own for. Comments cannot be
# interleaved into a line continuation, so they are indexed here instead; keep
# this list in step with the line below.
#
#   --pid=host              THE point of this container shape: the desktop
#                           shares the host's PID namespace, so Xorg's own
#                           SO_PEERCRED sees real host PIDs for every client
#                           connection, the stock X-Resource extension
#                           (XResQueryClientIds) works, and /proc inside the
#                           container is the host's - /proc/<pid>/cgroup then
#                           attributes any X client to the k8s pod that owns
#                           it (the pod UID is in the cgroup path). The cost
#                           and the mitigations are in the capability notes
#                           below; the image-side consequence is that systemd
#                           cannot run (it must be PID 1 of its namespace,
#                           and here the host's systemd is), which is why the
#                           image boots via desktop-init instead.
#
#   --systemd=false         Explicit, not merely the default: podman's
#                           default "true" AUTODETECTS systemd mode from the
#                           entrypoint, and this container must never get
#                           systemd mode (tmpfs remounts, SIGRTMIN+3 stop
#                           signal) by accident of entrypoint naming.
#
#   --tty                   Allocate a pty so the runtime creates
#                           /dev/console, which is what `podman logs` reads
#                           and where desktop-init and everything it starts
#                           write. Without it there is no /dev/console at
#                           all and the container's boot is invisible from
#                           the host.
#
#   --security-opt          AppArmor off - the Debian-family counterpart of
#     apparmor=unconfined   SecurityLabelDisable= below, and inert on the
#                           RHEL/Rocky targets this tree is written for. The
#                           full reasoning is with that directive.
#
#   --ulimit rtprio=95      RLIMIT_RTPRIO / RLIMIT_MEMLOCK for the audio stack,
#   --ulimit memlock=...    replacing rtkit and CAP_IPC_LOCK respectively - see
#                           the paragraph directly above. With no systemd in
#                           the image these now reach PipeWire by ordinary
#                           inheritance - the DefaultLimit* relay drop-ins are
#                           gone with the user manager.
#
#   --ulimit nice=31        RLIMIT_NICE for module-rt's nice.level = -11
#                           (expressed as 20 - nice). Was DefaultLimitNICE=31
#                           in the deleted realtime-limits.conf; stated here
#                           because rlimits are now the only delivery path.
#
#   --log-opt max-size=64m  Bound on the container log file - the sink the
#                           console stream lands in. See the logging block
#                           above; LogDriver= is a proper key, this half has
#                           none before podman 5.0.
#
#   --device-cgroup-rule    The device allowlist; the majors and the reason
#     (five of them)        each one is here are listed above. The values are
#                           QUOTED because quadlet splits PodmanArgs on
#                           whitespace and "c 13:* rwm" is ONE argument
#                           containing two spaces - unquoted it becomes three.
PodmanArgs=--pid=host --systemd=false --tty \
    --security-opt apparmor=unconfined \
    --log-opt max-size=64m \
    --ulimit rtprio=95 \
    --ulimit memlock=67108864 \
    --ulimit nice=31 \
    --device-cgroup-rule="c 13:* rwm" \
    --device-cgroup-rule="c 4:* rwm" \
    --device-cgroup-rule="c 5:* rwm" \
    --device-cgroup-rule="c 226:* rwm" \
    --device-cgroup-rule="c 116:* rwm"

# Capabilities: drop everything, add back only what is used. This set shrank
# when systemd left the image: SYS_ADMIN (systemd mounting cgroupfs/tmpfs,
# logind - the capability README.md used to single out as the one keeping
# this container trusted), SYS_NICE and SYS_RESOURCE (systemd scheduling and
# limit-raising), AUDIT_WRITE (pam_loginuid), SYS_CHROOT and NET_BIND_SERVICE
# (the ordinary systemd/PAM set) are all gone with it.
#
# KILL is dropped for a different reason: in the HOST pid namespace
# (--pid=host above) CAP_KILL would mean "may signal any process on the
# host". desktop-init never needs it - it signals the session by first
# becoming the desktop uid via setpriv (SETUID/SETGID below), and same-uid
# signaling needs no capability at all. That same-uid power is real and
# cuts both ways without a user namespace, which is why the desktop uid is
# 61000 (fixed in the image and in the tree's sysusers.d - one contract),
# far from the uid-1000 range where real host users live: the first e2e
# run of this shape used `pkill -u 1000` while the desktop still WAS uid
# 1000, and took down the test harness's own ssh session (the VM's login
# user shared the uid). desktop-init additionally scopes every kill to the
# session's own sid, never to the uid; processes of other uids are not
# signalable from the container at all.
#
#   SYS_TTY_CONFIG   Xorg's VT ioctls (VT_ACTIVATE at session start)
#   MKNOD            ensure-vt-devices.sh creating tty0/tty1 on the container's
#                    OWN /dev, deliberately: desktop-init chowns tty1 to the
#                    session user, and doing that to a host node would change
#                    the host's.
#   CHOWN            desktop-init: tty1 and XDG_RUNTIME_DIR to the session user
#   SETUID SETGID    setpriv (root -> desktop) for the session and for every
#                    signal desktop-init sends; the suid Xorg wrapper
#   DAC_OVERRIDE FOWNER FSETID SETPCAP
#                    root convenience for the oneshots and postmortem (reading
#                    the session user's Xorg log, fixing perms on host-shared
#                    dirs); candidates for trimming once the shape settles
#
# Notably NOT granted: everything --privileged gave, and now also SYS_ADMIN
# and KILL - see above. Still absent as before: SYS_MODULE, SYS_RAWIO,
# SYS_PTRACE (which is also what keeps host /proc's environ/mem unreadable
# from in here despite --pid=host), SYS_BOOT, SYS_TIME, NET_ADMIN, NET_RAW,
# BPF, PERFMON, SYSLOG, MAC_ADMIN, MAC_OVERRIDE, DAC_READ_SEARCH, IPC_LOCK,
# IPC_OWNER, LEASE, LINUX_IMMUTABLE, AUDIT_CONTROL, AUDIT_READ,
# BLOCK_SUSPEND, WAKE_ALARM, CHECKPOINT_RESTORE.
DropCapability=ALL
AddCapability=SYS_TTY_CONFIG MKNOD CHOWN SETUID SETGID
AddCapability=DAC_OVERRIDE FOWNER FSETID SETPCAP

# SELinux separation stays OFF. Confining this container would need a policy
# module of its own for DRM, evdev and VT access from a container domain -
# that is a project, not a setting, and container_t cannot do any of it. The
# CLIENT containers are confined (see "SELinux" in deploy/README.md); this one
# is the trusted component.
SecurityLabelDisable=true
# AppArmor is off too, via --security-opt apparmor=unconfined up in PodmanArgs
# (quadlet has no key for it). The same call on a distro that uses AppArmor
# instead of SELinux: --privileged was turning it off as well, and without it
# podman applies its default profile, under which dbus-broker fails to start
# and takes the login session with it (pam_systemd: "Transport endpoint is not
# connected"). Confining this container under AppArmor would need a profile of
# its own for exactly the reasons SELinux would, so the two are treated alike
# rather than one being enforced because the host happens to be Ubuntu.
#
# Inert on hosts without AppArmor, which includes the RHEL/Rocky targets this
# tree is written for; it matters for the CI runner and for anyone deploying on
# a Debian-family host.

# Seccomp is deliberately NOT disabled here. Omitting the flag leaves podman's
# default filter in place, which --privileged would have removed - the single
# largest piece of attack surface this change takes back.

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
