# Part of the desktop-container deploy tree (deploy/README.md).
[Unit]
Description=Write the CDI specs that share this desktop's display and audio with client containers
# Every host runs this, desktop up or not: the specs are the export
# contract (paths + DISPLAY), not a report on the desktop's state, so
# there is nothing to converge and no reason to gate them on the desktop
# starting.
#
# Unlike the other converger oneshots, this one is NOT only for
# desktop.service: on a kubernetes node the client PODS resolve these specs
# (via the device plugins that advertise them), and kubelet must find them
# before it admits a pod that requests one - which can happen on a boot
# where desktop.service has not started yet. Hence the [Install] below
# (shipped pre-enabled as a multi-user.target.wants symlink in this tree)
# in addition to desktop.container's Wants=.
Before=crio.service kubelet.service k3s.service k3s-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/desktop-client-cdi

[Install]
WantedBy=multi-user.target
