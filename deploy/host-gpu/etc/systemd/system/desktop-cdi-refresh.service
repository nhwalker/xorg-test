# desktop-container deploy tree, GPU host overlay (deploy/README.md).
[Unit]
Description=Regenerate the NVIDIA CDI spec for the containerized desktop
# /etc/cdi/nvidia.yaml pins driver library paths and versions; after a host
# driver update a stale spec makes container creation fail until the spec is
# regenerated. Doing it before every desktop start keeps the two coherent.
# Pulled in by the 10-gpu.conf quadlet drop-in (Wants=/After=), so it needs
# no [Install]/enable of its own; skipped cleanly if the NVIDIA device
# nodes are not there yet.
ConditionPathExists=/dev/nvidiactl
Before=desktop.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
