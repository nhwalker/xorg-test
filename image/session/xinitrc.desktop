#!/bin/sh
# X session started by startx (see start-session).

# The X socket is exported to the host via /tmp/.X11-unix; local peers
# (host processes, other containers sharing the socket dir) don't have our
# xauth cookie, so allow all local unix-socket connections.
xhost +local: || true

# Desktop replacement: no screen blanking / DPMS surprises by default.
xset s off || true
xset -dpms || true

# Dark theme base color; the rest of the palette is in ~/.Xdefaults, which
# Xt reads directly because nothing here sets RESOURCE_MANAGER (no xrdb).
# Adding an xrdb call would silently shadow that file — see its header.
xsetroot -solid '#101216' || true

xterm -geometry 100x30+60+60 &

# mwm answers SIGHUP, like SIGTERM, with Xlib calls from inside its handler.
# A stop signals every process of this container at once (podman stops a
# container that has no pid namespace of its own with kill --all), so mwm
# gets its SIGTERM while the server shuts down, and xinit, signalled too,
# sends it a SIGHUP on the way out. Inside both handlers mwm waits forever on
# Xlib's lock, until desktop-init's SIGKILL 5 s later. mwm keeps an ignore it
# inherits, so the SIGHUP never reaches it, and the SIGTERM alone ends it.
trap '' HUP
exec /usr/bin/mwm
