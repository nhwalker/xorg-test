#!/bin/bash
# Entry point for the desktop session. Launched by desktop-init as the
# "desktop" user on tty1 (setsid -c gave us the controlling tty; env -i
# built the environment). startx handles xauth cookie generation.
#
# The audio stack is started here directly - there is no systemd user
# manager in this image any more (see image/init/desktop-init). Two things
# systemd drop-ins used to arrange now happen inline:
#
#   umask 0000   the exported sockets in /run/desktop-audio must be
#                connectable by other uids (host users, other containers);
#                sockets inherit the daemon's umask. Was
#                pipewire-umask.conf.
#   rlimits      RLIMIT_RTPRIO/MEMLOCK/NICE arrive VERBATIM from the
#                quadlet's --ulimit flags: no PID-1 relay, no
#                DefaultLimit* drop-ins. module-rt takes the rlimit path
#                because the image config sets rlimits.enabled=true /
#                rtkit.enabled=false (see Containerfile).
#
# The daemons die with the session: they are children of this shell, and
# desktop-init's cleanup (uid-scoped pkill) reaps any survivor before the
# next iteration, so a restarted session can always re-bind its sockets.
#
# No failure handling here: when Xorg exits, the tty hangup kills this
# process group, and desktop-init runs session-postmortem from outside.
set -u

VT="${DESKTOP_VT:-vt1}"
DPY="${DESKTOP_DISPLAY:-:0}"

(
    umask 0000
    pipewire &
    # WirePlumber exits fatally ("Failed to connect to PipeWire") if the
    # core socket is not there yet, and unlike the systemd user units there
    # is no socket activation and no Restart= to hide that race - the first
    # e2e run of this shape lost its session manager to it (pipewire and
    # pipewire-pulse survived; wireplumber was simply gone, and with it
    # every ALSA device). PipeWire binds the socket within milliseconds,
    # but "within" is not "before": wait for it, bounded.
    for _ in $(seq 100); do
        [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] && break
        sleep 0.1
    done
    wireplumber &
    pipewire-pulse &
    wait
) &

# No -novtswitch: Xorg must VT_ACTIVATE its own VT at startup so the session
# becomes visible even if the console was left on another VT (chvt, rescue
# shell); with the flag it would render invisibly on an inactive VT.
exec /usr/bin/startx /etc/X11/xinit/xinitrc.desktop -- "$DPY" "$VT" -keeptty -nolisten tcp
