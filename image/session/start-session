#!/bin/bash
# Entry point for the desktop session. Launched by desktop-init as the
# "desktop" user on tty1 (setsid -c gave us the controlling tty; env -i
# built the environment). startx handles xauth cookie generation.
#
# X ONLY. The audio stack used to be started from here as a backgrounded
# subshell, which put PipeWire in the X session's process session and so
# made every Xorg exit an audio outage - desktop-init stops a session by
# killing its whole sid. It now lives in image/session/start-audio under
# a supervise loop of its own; see that file's header and desktop-init's.
#
# No failure handling here: when Xorg exits, the tty hangup kills this
# process group, and desktop-init runs session-postmortem from outside.
set -u

VT="${DESKTOP_VT:-vt1}"
DPY="${DESKTOP_DISPLAY:-:0}"

# No -novtswitch: Xorg must VT_ACTIVATE its own VT at startup so the session
# becomes visible even if the console was left on another VT (chvt, rescue
# shell); with the flag it would render invisibly on an inactive VT.
exec /usr/bin/startx /etc/X11/xinit/xinitrc.desktop -- "$DPY" "$VT" -keeptty -nolisten tcp
