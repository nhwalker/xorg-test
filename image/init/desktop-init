#!/bin/bash
# Container entrypoint: a small supervisor replacing systemd as this
# container's init.
#
# Why no systemd: the quadlet runs this container in the HOST's PID
# namespace (--pid=host) so that Xorg's own SO_PEERCRED sees real host
# PIDs and the X-Resource extension can attribute every X client to the
# k8s pod that owns it (/proc/<pid>/cgroup carries the pod UID; /proc
# inside this container IS the host's proc). systemd as a system manager
# refuses to run unless it is PID 1 of its namespace, and in the host
# namespace the host's systemd already is - so the two are mutually
# exclusive, and window-to-pod identity is what this image exists for.
#
# What systemd used to provide here, and where each duty went:
#   oneshots (xorg-conf.service)        -> run_oneshots() below, same order
#   PAM/logind session + user manager   -> run_session(): setpriv to the
#                                          desktop user, XDG_RUNTIME_DIR
#                                          created by hand; no seat, no utmp
#   PipeWire user units                 -> started by start-session directly;
#                                          the quadlet's --ulimit now reaches
#                                          them VERBATIM (no more
#                                          DefaultLimit* relay - that whole
#                                          class of bug is gone)
#   journald + journal-console.service  -> nothing: children inherit this
#                                          process's stdout, which podman's
#                                          --tty wires to /dev/console, so
#                                          `podman logs` sees everything with
#                                          no forwarder and no journal to
#                                          bound
#   Restart=always / ExecStopPost       -> the supervise loop + postmortem
#                                          call at the bottom
#
# Signals: podman stop sends SIGTERM (STOPSIGNAL in the Containerfile).
# CAP_KILL is deliberately NOT granted - in the host pid namespace it would
# mean "can signal any process on the host" - so this root process cannot
# signal the desktop user's session directly. Every kill goes through
# setpriv to the desktop uid first: same-uid signaling needs no capability.
#
# Test contract (ci/smoke-deploy.sh, ci/vm/vm-guest.sh):
#   /run/desktop-init.pid    this process's pid, which IS a host pid -
#                            the replacement for every /proc/1/... probe
#   /run/desktop-init-ready  written once the oneshots have run and the
#                            session has been launched (the replacement for
#                            `systemctl is-system-running`); the session
#                            itself may still fail on a GPU-less host, which
#                            the ready file deliberately does not gate on
set -u

log() { echo "desktop-init: $*"; }

# 61000: fixed in the image (Containerfile useradd) and in the deploy
# tree's sysusers.d for the HOST account of the same name - the host's
# desktop-session.service logs in as it, and this uid must never collide
# with a real host user's (see session_members below for what a collision
# cost when this was 1000).
DESK_UID=61000
DESK_USER=desktop
RUNDIR=/run/user/$DESK_UID

as_desktop() {
    # Same-uid operations for the session user; used for signaling (see the
    # CAP_KILL note above) and cleanup. --init-groups picks up the aligned
    # device groups, which matters for the session itself, not for kill.
    setpriv --reuid=$DESK_UID --regid=$DESK_UID --init-groups "$@"
}

session_pid=""
shutting_down=0

session_members() {
    # Every pid in the session's SESSION (setsid made $session_pid a session
    # leader, and the sid survives the leader's death for orphans). NEVER
    # scope this by uid: in the host pid namespace a uid-wide pkill reaches
    # every same-uid process ON THE HOST - when the desktop was still uid
    # 1000, the first e2e run of this shape killed the test harness's own
    # ssh session that way (the VM's login user shared the uid). The uid
    # has since moved to 61000, and the HOST desktop-session.service's lead
    # process legitimately runs as it - one more process a uid-scoped kill
    # would wrongly take down. The session id is unique to our tree; the
    # signals still go through setpriv because same-uid needs no capability.
    [ -n "$session_pid" ] || return 0
    ps -eo pid=,sess= | awk -v s="$session_pid" '$2==s{print $1}'
}

stop_session() {
    # TERM the session tree, then KILL stragglers. Root's own pid never
    # appears here (desktop-init is not in that session), so no self-kill.
    local pids
    pids=$(session_members)
    [ -n "$pids" ] || return 0
    # shellcheck disable=SC2086
    as_desktop kill -TERM $pids 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        pids=$(session_members)
        [ -n "$pids" ] || return 0
        sleep 1
    done
    # shellcheck disable=SC2086
    as_desktop kill -KILL $pids 2>/dev/null || true
}

on_term() {
    log "SIGTERM: stopping session"
    shutting_down=1
    stop_session
    exit 0
}
trap on_term TERM INT

echo $$ > /run/desktop-init.pid

run_oneshots() {
    # Same content and order as the old xorg-conf.service +
    # desktop-tools-publish.service. "|| true" mirrors the units' "-"
    # prefixes: diagnostics log but never block the session.
    /usr/local/bin/ensure-vt-devices.sh || true
    /usr/local/bin/align-device-groups.sh || true
    /usr/local/bin/host-shell-setup.sh || true
    /usr/local/bin/preflight-check.sh || true
    /usr/local/bin/xorg-gpu-conf.sh \
        || log "xorg-gpu-conf failed; session will try autodetection"
    /usr/local/bin/xorg-monitor-conf.sh || true
    # Publish failure must be loud (clients would get a missing/stale
    # toolkit) but must not take the display down with it.
    /usr/local/bin/publish-tools.sh \
        || log "ERROR: publish-tools failed; desktop.local/tools clients get a stale or empty toolkit"
}

prepare_runtime() {
    # The runtime dir. First choice: the real thing - the host's
    # desktop-session.service opens a PAM/logind session for the desktop
    # user, logind mounts the per-user tmpfs at /run/user/61000 on the
    # host, and it reaches this mount namespace through the quadlet's
    # rslave /run/user bind. The session unit starts AFTER the container
    # (After=desktop.service), so wait briefly for it. Fallback: fabricate
    # the dir ourselves, exactly as before - a host without the session
    # unit (plain podman run, the unit disabled) still gets a working
    # desktop, just without the seat bookkeeping.
    for _ in $(seq 30); do
        [ -d "$RUNDIR" ] && break
        sleep 0.5
    done
    if [ -d "$RUNDIR" ]; then
        log "runtime dir $RUNDIR provided by the host login session"
    else
        log "no host login session appeared; creating $RUNDIR standalone"
        mkdir -p "$RUNDIR"
        chown $DESK_UID:$DESK_UID "$RUNDIR"
        chmod 700 "$RUNDIR"
    fi
    # Normally the host mount; keep working without it (was tmpfiles.d).
    mkdir -p /run/desktop-audio
    chmod 1777 /run/desktop-audio
    # The session owns the VT (systemd's TTYPath= used to chown this).
    [ -c /dev/tty1 ] && chown $DESK_UID:tty /dev/tty1 || true
}

clear_stale_audio_sockets() {
    # PipeWire will NOT re-bind over a leftover socket file, and the export
    # dir is host-shared, so sockets survive session AND container restarts
    # as present-but-dead files; every audio client then gets ECONNREFUSED.
    # Ran once per boot under systemd; per session iteration here, because
    # the audio daemons now live and die with the session.
    rm -f /run/desktop-audio/pulse /run/desktop-audio/pipewire-0 \
        /run/desktop-audio/pipewire-0-manager /run/desktop-audio/pipewire-0.lock \
        /run/desktop-audio/pipewire-0-manager.lock
}

run_session() {
    # setsid -c: fresh session with fd 0's tty (tty1) as controlling tty -
    # what StandardInput=tty used to arrange, and what lets Xorg -keeptty
    # take the VT. env -i: no PAM to build the environment, so state it.
    setsid -c env -i \
        HOME=/home/$DESK_USER USER=$DESK_USER LOGNAME=$DESK_USER \
        SHELL=/bin/bash PATH=/usr/local/bin:/usr/bin:/usr/sbin \
        XDG_RUNTIME_DIR="$RUNDIR" XDG_SESSION_TYPE=x11 \
        DESKTOP_VT=vt1 DESKTOP_DISPLAY=:0 \
        setpriv --reuid=$DESK_UID --regid=$DESK_UID --init-groups \
        /usr/local/bin/start-session < /dev/tty1 &
    session_pid=$!
    wait "$session_pid"
}

log "starting (host pid $$)"
run_oneshots
prepare_runtime
touch /run/desktop-init-ready
log "oneshots done; supervising session (restart on exit, 3s backoff)"

while :; do
    clear_stale_audio_sockets
    [ -c /dev/tty1 ] && chown $DESK_UID:tty /dev/tty1 || true
    run_session
    rc=$?
    [ "$shutting_down" = 1 ] && exit 0
    # Orphans from the dead session (audio daemons, xterm) must not
    # survive into the next iteration or PipeWire cannot re-bind.
    stop_session
    if [ "$rc" != 0 ]; then
        SERVICE_RESULT=exit-code EXIT_CODE=exited EXIT_STATUS=$rc \
            /usr/local/bin/session-postmortem || true
    fi
    log "session exited (rc=$rc); restarting in 3s"
    sleep 3
done
