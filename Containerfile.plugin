# cdi-device-plugin APPLICATION build: copies the Go source into the
# prebuilt dependency base (Containerfile.plugin.base), compiles offline,
# and ships the static binary on scratch. Fully offline:
#
#   podman build --network=none -t localhost/cdi-device-plugin:latest -f Containerfile.plugin .
#
# Override the base with --build-arg BASE_IMAGE=<ref>. If the build fails
# resolving modules, go.mod/go.sum changed since the base was built --
# rebuild the base (with network) first.

ARG BASE_IMAGE=localhost/cdi-device-plugin-base:latest

FROM ${BASE_IMAGE} AS build
# GOPROXY=off turns any dependency miss into a hard, clear error instead of
# a network attempt; -mod=readonly refuses to silently edit go.mod.
ENV GOTOOLCHAIN=local GOPROXY=off GOFLAGS=-mod=readonly
WORKDIR /src
# Includes go.mod/go.sum: the base deleted its copies after populating the
# module cache, so the source tree's manifests are the only ones in play.
COPY cdi-device-plugin/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /cdi-device-plugin .

FROM scratch
COPY --from=build /cdi-device-plugin /cdi-device-plugin
ENTRYPOINT ["/cdi-device-plugin"]
