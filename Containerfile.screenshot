# screenshot APPLICATION build: copies the Go source into the prebuilt
# dependency base (Containerfile.screenshot.base), compiles offline, and ships
# the static binary on scratch. Fully offline:
#
#   podman build --network=none -t localhost/screenshot:latest -f Containerfile.screenshot .
#
# Override the base with --build-arg BASE_IMAGE=<ref>. If the build fails
# resolving modules, go.mod/go.sum changed since the base was built -- rebuild
# the base (with network) first.
#
# The image exists to CARRY the binary, not to run it: nothing about this tool
# is containerized in production. Whatever mechanism ends up publishing it to a
# host path for the CDI specs to mount can `COPY --from` this image, and
# Containerfile.testclient already does exactly that for the e2e.

ARG BASE_IMAGE=localhost/screenshot-base:latest

FROM ${BASE_IMAGE} AS build
# GOPROXY=off turns any dependency miss into a hard, clear error instead of a
# network attempt; -mod=readonly refuses to silently edit go.mod.
ENV GOTOOLCHAIN=local GOPROXY=off GOFLAGS=-mod=readonly
WORKDIR /src
# Includes go.mod/go.sum: the base deleted its copies after populating the
# module cache, so the source tree's manifests are the only ones in play.
COPY screenshot/ .
# CGO_ENABLED=0: the binary is injected into arbitrary client images (ubi9,
# alpine, distroless), so it must not depend on a libc being present.
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /screenshot .

FROM scratch
COPY --from=build /screenshot /screenshot
ENTRYPOINT ["/screenshot"]
